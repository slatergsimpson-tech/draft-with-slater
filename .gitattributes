# Normalise to LF in the repository, then check out what each platform needs.
* text=auto eol=lf

# The Windows launcher is run by cmd.exe, which is happiest with CRLF.
*.cmd text eol=crlf

# The macOS launcher is a shell script: CRLF would break its shebang line.
*.command text eol=lf
*.sh      text eol=lf
